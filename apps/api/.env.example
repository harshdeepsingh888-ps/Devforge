# PostgreSQL Database Connection String
# Must match docker-compose.yml for local development. Never commit real credentials.
DATABASE_URL="postgresql://devforge_user:devforge_dev_password@localhost:5432/devforge?schema=public"

# Authentication Security Configs
# Generate a unique secret per environment (at least 32 bytes). For example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=devforge-api
JWT_AUDIENCE=devforge-web
JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000

# API Server Host & Port
PORT=5000
HOST=0.0.0.0
