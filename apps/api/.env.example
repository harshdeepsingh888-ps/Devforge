# PostgreSQL Database Connection String
# Must match docker-compose.yml for local development. Never commit real credentials.
DATABASE_URL="postgresql://devforge_user:devforge_dev_password@localhost:5432/devforge?schema=public"

# Authentication Security Configs
# Generate a unique secret per environment (at least 32 bytes). For example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=devforge-api
JWT_AUDIENCE=devforge-web
JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000

# API Server Host & Port
PORT=5000
HOST=0.0.0.0

# Number of reverse proxies in front of the API (for example 1 on a host that
# terminates TLS and forwards requests). Leave unset when the API is reached
# directly. A hop count only: "true" is refused because it would trust a header
# the client controls, and the rate limiter would be trivial to bypass.
# TRUST_PROXY=1

# Set to true in a container to apply database migrations before the server
# starts (the Docker image's entrypoint reads it). Leave unset locally; use
# npm run db:migrate instead.
# RUN_MIGRATIONS_ON_START=true

# Temporary, for calibrating TRUST_PROXY on a new host: adds the client address
# and the raw X-Forwarded-For header to the request log. Off by default because
# they are personal data. See docs/DEPLOY.md.
# LOG_CLIENT_ADDRESS=true
