{
    "name": "@devforge/api",
    "version": "0.1.0",
    "private": true,
    "description": "Backend API for DevForge.",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test \"src/**/*.test.ts\""
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@fastify/helmet": "^13.1.0",
        "fastify": "^5.10.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
