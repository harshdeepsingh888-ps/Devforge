{
    "name":  "devforge",
    "version":  "0.1.0",
    "private":  true,
    "description":  "A developer workspace for preserving project context, decisions, progress, and next actions.",
    "workspaces":  [
                       "apps/*"
                   ],
    "scripts":  {
                    "dev:api":  "npm run dev --workspace @devforge/api",
                    "build:api":  "npm run build --workspace @devforge/api",
                    "typecheck:api":  "npm run typecheck --workspace @devforge/api",
                    "build":  "npm run build:api",
                    "typecheck":  "npm run typecheck:api",
                    "test":  "npm run test --workspace @devforge/api"
                },
    "engines":  {
                    "node":  "\u003e=24"
                }
}
